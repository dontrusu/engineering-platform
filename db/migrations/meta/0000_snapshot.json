      "checkConstraints": {
        "projects_name_not_blank": {
          "name": "projects_name_not_blank",
          "value": "length(btrim(\"projects\".\"name\")) > 0"
        },
        "projects_slug_format": {
          "name": "projects_slug_format",
          "value": "\"projects\".\"slug\" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'"
        },
        "projects_technologies_not_empty": {
          "name": "projects_technologies_not_empty",
          "value": "cardinality(\"projects\".\"technologies\") > 0"
        },
        "projects_technologies_not_blank": {
          "name": "projects_technologies_not_blank",
          "value": "array_position(\"projects\".\"technologies\", null) is null and array_to_string(\"projects\".\"technologies\", chr(31)) !~ ('(^|' || chr(31) || ')[[:space:]]*(' || chr(31) || '|$)')"
        },
        "projects_description_not_blank": {
          "name": "projects_description_not_blank",
          "value": "length(btrim(\"projects\".\"description\")) > 0"
        },
        "projects_deployment_link_https": {
          "name": "projects_deployment_link_https",
          "value": "\"projects\".\"deployed_href\" is null or \"projects\".\"deployed_href\" ~ '^https://[^[:space:]/?#]+([/?#][^[:space:]]*)?$'"
        },
        "projects_display_order_nonnegative": {
          "name": "projects_display_order_nonnegative",
          "value": "\"projects\".\"display_order\" >= 0"
        }
      },
